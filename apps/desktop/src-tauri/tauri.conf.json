{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basics",
  "version": "1.2.0",
  "identifier": "dev.basics.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Basics",
        "url": "loading.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/basics/": "basics/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Your tech-stack vault for coding agents",
    "longDescription": "Basics keeps your tech stack, practices and checks as Markdown notes and shares them with your coding agents over MCP."
  }
}
