{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basics",
  "version": "1.4.2",
  "identifier": "dev.basics.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/basics/": "basics/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Your tech-stack vault for coding agents",
    "longDescription": "Basics keeps your tech stack, practices and checks as Markdown notes and shares them with your coding agents over MCP.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"]
      }
    }
  }
}
